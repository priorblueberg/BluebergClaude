# Copie para .env e preencha com os valores do projeto Supabase.
# A publishable/anon key vai embutida no bundle do frontend (nao e segredo),
# mas mantemos fora do repo publico por higiene.
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-publishable-ou-anon-key"

# Legados (compat com libs que leem sem o prefixo VITE_)
SUPABASE_URL="https://seu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-publishable-ou-anon-key"
